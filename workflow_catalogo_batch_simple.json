            {
              "id": "aggregate-batch",
              "name": "batchRows",
              "type": "array",
              "value": "={{ $input.all().map((item, idx) => ({ \n  rowIndex: idx + 1,\n  MACRO: item.json.MACRO || '',\n  DESCRIZIONE: item.json['DESCRIZIONE  COMPLETA                                   '] || item.json['DESCRIZIONE'] || '',\n  UM: item.json['U.M.'] || '',\n  QTA: item.json[\"Q.TA'\"] || '',\n  COSTO: item.json['COSTO UNITAR. MATERIALE'] || '',\n  TEMPO: item.json['Tempo pos min/copp'] || ''\n})) }}"
            }
          ]
        },
        "options": {}
